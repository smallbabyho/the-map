# 이 파일을 복사해서 .env.local 을 만들고 값을 채우세요. (.env.local 은 커밋되지 않습니다)
#   cp .env.example .env.local
# NEXT_PUBLIC_ 으로 시작하는 값은 브라우저에 그대로 노출됩니다 → 공개해도 되는 키만 넣으세요.
# 값을 바꾼 뒤에는 npm run dev 를 껐다 켜세요.

# 카카오맵 JavaScript 키 (비워두면 미리보기 지도 + 샘플 장소 검색으로 동작)
NEXT_PUBLIC_KAKAO_MAP_KEY=

# ODsay 대중교통 API 키 (lab.odsay.com → Web 플랫폼, URL 에 http://localhost:3000 등록)
# 비워두면 대중교통 구간은 직선거리 예상치로 보여줌. 넣으면 버스 번호·지하철 노선·환승·요금까지 보여줌.
NEXT_PUBLIC_ODSAY_KEY=

# 카카오 REST API 키 (자동차 길찾기, 서버 전용 → NEXT_PUBLIC_ 붙이지 않음). 카카오 개발자 콘솔 → 앱 키 → REST API 키
# 비워두면 자동차도 OpenStreetMap 길찾기(신호·정체 미반영)로 계산함
KAKAO_REST_KEY=

# Supabase · 캡차 (백엔드 연결 후 사용, backend/README.md 참고)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# 사이트 대표 주소 (공유 · 초대 링크, 인증 메일에 쓰임). 로컬에서는 비워두기 → 지금 열린 주소(localhost:3000)를 씀
# Vercel Production 에는 https://myconceptmap.vercel.app
NEXT_PUBLIC_SITE_URL=

# 네이버로 시작하기 (서버 전용 → NEXT_PUBLIC_ 붙이지 않음, backend/README.md 6번 참고). 비워두면 네이버 버튼만 안 됨
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# Supabase 관리자 키 (RLS 무시!). 네이버 로그인 사용자 만들기에만 서버에서 씀. 절대 NEXT_PUBLIC_ 로 바꾸지 말 것
SUPABASE_SERVICE_ROLE_KEY=
