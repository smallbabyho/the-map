# 이 파일을 복사해서 .env.local 을 만들고 값을 채우세요. (.env.local 은 커밋되지 않습니다)
#   cp .env.example .env.local
# NEXT_PUBLIC_ 으로 시작하는 값은 브라우저에 그대로 노출됩니다 → 공개해도 되는 키만 넣으세요.
# 값을 바꾼 뒤에는 npm run dev 를 껐다 켜세요.

# 카카오맵 JavaScript 키 (비워두면 미리보기 지도 + 샘플 장소 검색으로 동작)
NEXT_PUBLIC_KAKAO_MAP_KEY=

# Supabase · 캡차 (백엔드 연결 후 사용, backend/README.md 참고)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
